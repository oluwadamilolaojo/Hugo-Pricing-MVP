# Hugo Pricing Calculator — Environment Variables
# Copy this to .env.local for local development
# Add these to your Vercel project settings for production

# ── Required for email notifications ─────────────────────────────────────────
# Sign up free at https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From address (use resend.dev for testing, your domain for production)
FROM_EMAIL="Hugo Pricing <noreply@resend.dev>"

# ── App URL (used in email links) ─────────────────────────────────────────────
# For local dev: http://localhost:3000
# For Vercel: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Optional: Upgrade to shared server-side storage ──────────────────────────
# Without this, data lives in localStorage (single browser only)
# To share data across users:
#   1. Create a free Redis database at https://upstash.com
#   2. Copy the REST URL and token from your database dashboard
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
